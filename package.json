{
  "name": "meetnote-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:insforge": "node scripts/insforge-smoke-test.mjs",
    "db:migrations:new": "npx --yes @insforge/cli db migrations new",
    "db:migrations:up": "npx --yes @insforge/cli db migrations up --all",
    "db:migrations:list": "npx --yes @insforge/cli db migrations list",
    "db:tables": "npx --yes @insforge/cli db tables"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@gsap/react": "^2.1.2",
    "@insforge/sdk": "^1.2.5",
    "gsap": "^3.15.0",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "openai": "^6.34.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
